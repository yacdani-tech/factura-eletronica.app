# Superficie API — plantilla de variables de entorno (apps/api).
# Copiá este archivo a .env.local y completá con las llaves reales.
# .env.local está en .gitignore: NUNCA se commitean valores reales.
#
# Esta app es la ÚNICA superficie autorizada a usar `service_role` y (a futuro)
# las llaves de firma de Hacienda. NUNCA prefijar secretos con NEXT_PUBLIC_.

# URL del proyecto Supabase (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=

# Llave service_role (SOLO servidor). Requerida por las rutas que bypassan RLS
# (generación de facturas de suscripción sin sesión, jobs de sistema).
SUPABASE_SERVICE_ROLE_KEY=

# Secreto de los Vercel Cron jobs (`apps/api/vercel.json`). Las rutas
# `/api/cron/*` exigen `Authorization: Bearer ${CRON_SECRET}`; sin esta var
# responden 401 (fail-closed). Rotable desde el dashboard de Vercel.
CRON_SECRET=

# --- Hacienda (facturación electrónica CR) — placeholders del flujo real ---
# La implementación real vive SOLO en esta app; hoy `@factura/hacienda-adapter`
# es un STUB tipado y estas variables aún no se consumen.

# Ambiente del IDP/recepción de Hacienda: sandbox | produccion
HACIENDA_AMBIENTE=sandbox
# Usuario del ATV / API del emisor.
HACIENDA_USUARIO=
# Clave del usuario del ATV / API.
HACIENDA_CLAVE=
# Certificado de firma (.p12) del emisor, codificado en base64.
HACIENDA_CERT_P12_BASE64=
# PIN del certificado .p12.
HACIENDA_CERT_PIN=
