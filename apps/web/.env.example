# Plataforma — plantilla de variables de entorno (apps/web).
# Copiá este archivo a .env.local y completá con las llaves del proyecto Supabase.
# .env.local está en .gitignore: NUNCA se commitean valores reales.

# URL del proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Llave publicable / anon (pública, segura para el navegador; el aislamiento lo da RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave service_role (SOLO servidor). NUNCA prefijar con NEXT_PUBLIC_ ni exponerla
# al cliente. Requerida por operaciones server-side que bypassan RLS
# (escritura a buckets deny-by-default, jobs sin sesión, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# Dominio raíz de producción (sin subdominio), usado para resolver el tenant por
# subdominio en el middleware y para armar el `emailRedirectTo` del registro.
# Default si se omite: factura-eletronica.app.
NEXT_PUBLIC_APP_ROOT_DOMAIN=factura-eletronica.app

# URL base pública de este deploy (con protocolo), usada como fallback para
# `emailRedirectTo` cuando no se puede derivar del host de la request. En dev:
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (envío de emails, SOLO servidor). Sin esta llave el correo simplemente
# NO se envía (la acción no falla).
RESEND_API_KEY=
# Remitente verificado en Resend (dominio propio, ej. no-reply@factura-eletronica.app).
RESEND_FROM_EMAIL=
# Apagado explícito del envío de correo (SOLO el valor exacto "off" desactiva;
# cualquier otro valor o ausencia lo deja activo). Usado en dev/test/E2E.
RESEND_ENVIO=off

# Secreto de los Vercel Cron jobs (`apps/web/vercel.json`). Las rutas
# `/api/cron/*` exigen el header `Authorization: Bearer ${CRON_SECRET}`; sin
# esta var configurada las rutas responden 401 (fail-closed). Rotable desde el
# dashboard de Vercel. Requerido por la generación diaria de facturas de
# suscripción (`/api/cron/generar-suscripciones`).
CRON_SECRET=

# Infra E2E mínima (Playwright, apps/web/e2e/). Credenciales del tenant/usuario
# Admin de PRUEBA (correo/contraseña) sembrado con `npm run test:e2e:seed`. Sin
# estas dos vars, los specs de e2e/*.spec.ts se SALTAN (test.skip). También deben
# existir como secrets de GitHub Actions (mismos nombres) para el job "e2e".
E2E_TEST_TENANT_EMAIL=
E2E_TEST_TENANT_PASSWORD=
