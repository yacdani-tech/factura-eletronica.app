# Plataforma — plantilla de variables de entorno (apps/landing).
# Copiá este archivo a .env.local. .env.local está en .gitignore.

# URL pública del sitio de marketing (con protocolo). Default: https://factura-eletronica.app
NEXT_PUBLIC_SITE_URL=https://factura-eletronica.app

# Modo mantenimiento: si es exactamente "true", el landing marca noindex/nofollow.
MAINTENANCE_MODE=false
