{
  "//": "Plantilla. Copiar a settings.local.json (gitignoreado, por máquina) y ajustar. NO commitear settings.local.json.",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git check-ignore *)",
      "Bash(git init *)",
      "Bash(git remote *)",
      "Bash(git ls-remote *)",
      "PowerShell(npm run *)",
      "PowerShell(npm install *)",
      "PowerShell(git *)",
      "Bash(npx playwright *)",
      "Bash(npx supabase *)",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledMcpjsonServers": [
    "playwright",
    "supabase"
  ]
}
